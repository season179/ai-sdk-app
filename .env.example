OPENROUTER_API_KEY=
# Initial selection and fallback when the composer's model picker has no/invalid choice.
OPENROUTER_DEFAULT_MODEL=
# Optional: search (default) or all
TOOL_EXPOSURE_MODE=search

# Scheduled tasks (pg-boss). Any local Postgres works with an ai_sdk_app role/database.
DATABASE_URL=postgres://ai_sdk_app:ai_sdk_app@localhost:5432/ai_sdk_app
PGBOSS_SCHEMA=pgboss
DEFAULT_SCHEDULE_TIMEZONE=UTC

# Self-improvement turn review + automatic pre-turn recall (off by default).
SELF_IMPROVEMENT_ENABLED=false

# Governed agent-memory write pipeline (off by default). When false, chat
# messages still persist, but trace journaling, grounded observations, and
# automatic review writes are disabled. Explicit memory management remains
# available. Automatic recall is read-only and
# remains controlled by SELF_IMPROVEMENT_ENABLED.
AGENT_MEMORY_WRITE_ENABLED=false
AGENT_MEMORY_POLICY_VERSION=write-v1
AGENT_MEMORY_TRACE_RETENTION_DAYS=30
AGENT_MEMORY_GATE_MIN_SCORE_BPS=6500

# V2 running profile. All behavior flags are OFF / safe by default. Automatic
# synthesis additionally requires AGENT_MEMORY_WRITE_ENABLED=true; read/injection
# and explicit user-authority writes remain independent of self-improvement.
AGENT_PROFILE_ENABLED=false
AGENT_PROFILE_SYNTHESIS_ENABLED=false
AGENT_PROFILE_TOKEN_BUDGET=1000
AGENT_PROFILE_MAX_CHARS=4500
AGENT_PROFILE_SYNTHESIS_CRON="0 3 * * *"
AGENT_PROFILE_SYNTHESIS_TIMEZONE=UTC
# Empty = fall back to SELF_IMPROVEMENT_MODEL, then OPENROUTER_DEFAULT_MODEL.
AGENT_PROFILE_SYNTHESIS_MODEL=
AGENT_PROFILE_POLICY_VERSION=profile-v1
AGENT_PROFILE_EXPLICIT_WRITE_ENABLED=false
CONVERSATION_SEARCH_ENABLED=false

# Memory consolidation (§5). One feature behind independent switches; all OFF /
# safe by default. Ship dark → dry-run → proposals → (optional) auto-apply.
MEMORY_CONSOLIDATION_ENABLED=false
MEMORY_CONSOLIDATION_DRY_RUN=true
MEMORY_CONSOLIDATION_AUTO_APPLY=false
# pg-boss cron for the sweep, e.g. "0 3 * * *". Empty = do not schedule.
MEMORY_CONSOLIDATION_CRON=
MEMORY_CONSOLIDATION_VERBOSE=false

# Direct, on-demand memory_search tool only. Independent of automatic recall,
# review, consolidation, and TOOL_EXPOSURE_MODE; never bridge-reachable.
MEMORY_SEARCH_ENABLED=false
