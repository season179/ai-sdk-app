OPENROUTER_API_KEY=
# Initial selection and fallback when the composer's model picker has no/invalid choice.
OPENROUTER_DEFAULT_MODEL=
# Optional: search (default) or all
TOOL_EXPOSURE_MODE=search

# Scheduled tasks (pg-boss). Any local Postgres works with an ai_sdk_app role/database.
DATABASE_URL=postgres://ai_sdk_app:ai_sdk_app@localhost:5432/ai_sdk_app
PGBOSS_SCHEMA=pgboss
DEFAULT_SCHEDULE_TIMEZONE=UTC

# Self-improvement / turn review (off by default).
SELF_IMPROVEMENT_ENABLED=false

# Governed agent-memory write pipeline (off by default).
AGENT_MEMORY_WRITE_ENABLED=false
AGENT_MEMORY_POLICY_VERSION=write-v1
AGENT_MEMORY_TRACE_RETENTION_DAYS=30
AGENT_MEMORY_GATE_MIN_SCORE_BPS=6500

# Memory consolidation (§5). One feature behind independent switches; all OFF /
# safe by default. Ship dark → dry-run → proposals → (optional) auto-apply.
MEMORY_CONSOLIDATION_ENABLED=false
MEMORY_CONSOLIDATION_DRY_RUN=true
MEMORY_CONSOLIDATION_AUTO_APPLY=false
# pg-boss cron for the sweep, e.g. "0 3 * * *". Empty = do not schedule.
MEMORY_CONSOLIDATION_CRON=
MEMORY_CONSOLIDATION_VERBOSE=false

# Agent-facing memory_search tool (§10). Independent of consolidation flags.
MEMORY_SEARCH_ENABLED=false
