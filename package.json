{
  "name": "ai-sdk-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11 <12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "concurrently --names app,worker,review,consolidation --prefix-colors blue,magenta,cyan,green \"portless\" \"pnpm run worker:scheduled-tasks\" \"pnpm run worker:turn-review\" \"pnpm run worker:consolidation\"",
    "dev:app": "next dev",
    "dev:tunnel": "portless",
    "build": "next build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "worker:scheduled-tasks": "tsx workers/scheduled-tasks.ts",
    "worker:turn-review": "tsx workers/turn-review.ts",
    "worker:consolidation": "tsx workers/consolidation.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "3.0.199",
    "@openrouter/ai-sdk-provider": "2.9.0",
    "ai": "6.0.197",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cron-parser": "^5.5.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "1.17.0",
    "next": "16.2.7",
    "next-themes": "^0.4.6",
    "pg": "^8.21.0",
    "pg-boss": "^12.18.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "25.9.1",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "4.3.0",
    "tsx": "^4.22.4",
    "typescript": "6.0.3",
    "vitest": "^4.1.9"
  }
}
