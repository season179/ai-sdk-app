{
  "name": "ai-sdk-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11 <12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "mkdir -p logs && concurrently --names app,worker,review,consolidation --prefix-colors blue,magenta,cyan,green \"portless\" \"pnpm run worker:scheduled-tasks\" \"pnpm run worker:turn-review\" \"pnpm run worker:consolidation\" 2>&1 | tee /dev/tty | /usr/sbin/rotatelogs -n 2 logs/dev.log 5M",
    "dev:app": "next dev",
    "dev:tunnel": "portless",
    "build": "next build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "worker:scheduled-tasks": "tsx workers/scheduled-tasks.ts",
    "worker:turn-review": "tsx workers/turn-review.ts",
    "worker:consolidation": "tsx workers/consolidation.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "3.0.199",
    "@openrouter/ai-sdk-provider": "2.9.0",
    "ai": "6.0.197",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cron-parser": "^5.9.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "1.31.0",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "pg-boss": "^12.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.12",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  }
}
