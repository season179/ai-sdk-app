# Fail install if Node/pnpm don't satisfy the "engines" field in package.json
engine-strict=true

# pnpm auto-switches to the version pinned in "packageManager" (pnpm@11.5.1)
manage-package-manager-versions=true

# Optional, strongest Node lock: makes pnpm download & run this exact Node for
# every pnpm-invoked script, regardless of the user's installed Node. Uncomment
# to force it (note: pins an exact patch, not just the v24 major line).
# use-node-version=24.16.0
